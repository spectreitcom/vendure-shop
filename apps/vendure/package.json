    "@vendure/dashboard": "3.7.3",
    "@vendure/email-plugin": "3.7.3",
    "@vendure/graphiql-plugin": "3.7.3",
    "dotenv": "^16.4.5",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vendure/cli": "3.7.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
