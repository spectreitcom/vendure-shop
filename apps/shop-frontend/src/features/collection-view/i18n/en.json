{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "collection_error_title": "We couldn’t load this collection.",
  "collection_error_description": "Please try again in a moment, or explore our other collections.",
  "collection_back_to_shop": "Back to shop",
  "collection_hero_eyebrow": "Explore the collection",
  "collection_discover_link": "Discover the collection",
  "collection_filters_label": "Product filters",
  "collection_products_label": "Collection products",
  "collection_selection_eyebrow": "The selection",
  "collection_results_title": "Explore {name}",
  "collection_products_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} product",
        "countPlural=*": "{count} products"
      }
    }
