  "collection_showing": "Showing {from}–{to} of {total}",
  "collection_empty_title": "No products found",
  "collection_empty_filtered_description": "Try removing a filter to discover more from this collection.",
  "collection_empty_description": "There are no products in this collection yet. Explore the rest of the shop.",
  "collection_clear_all_filters": "Clear all filters",
  "collection_filters_title": "Filters",
  "collection_filters_caption": "Refine your selection",
  "collection_filters_clear_all": "Clear all",
  "collection_product_view": "View product",
  "collection_product_pricing_fallback": "See product for pricing"
}
