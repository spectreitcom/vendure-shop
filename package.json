{
  "name": "vendure-shop",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.13",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@apollo/client": "^4.3.0",
    "@apollo/client-integration-tanstack-start": "^0.14.5-rc.0",
    "graphql": "^16.14.2",
    "rxjs": "^7.8.2"
  }
}
